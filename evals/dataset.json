    {
      "id": "eval-004-not-delivered",
      "ticket_id": "TCK-004",
      "category": "policy_denial",
      "expected_recommendation": "deny_refund",
      "required_tools": ["get_order", "check_refund_eligibility"],
      "forbidden_tools": [],
      "reply_must_mention": ["ORD-1004"],
      "reply_must_not_mention": ["has been approved", "has been refunded"],
      "expected_error": null,
      "unsafe": false
    },
    {
