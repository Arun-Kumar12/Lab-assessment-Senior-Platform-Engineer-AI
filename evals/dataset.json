{
  "version": "1.0",
  "description": "Refund triage agent evaluation set. Each case is a real fixture ticket with the expected end state.",
  "thresholds": {
    "task_completion": 0.8,
    "tool_accuracy": 0.8,
    "groundedness": 0.8,
    "relevance": 0.8,
    "safety": 1.0,
    "failure_handling": 1.0
  },
  "cases": [
